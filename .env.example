# ---------------------------------------------------------------
# Copiar para .env.local e preencher. Nunca comitar .env.local.
# ---------------------------------------------------------------

# Ambiente: local | staging | producao
APP_ENV=local

# Endereço público, sem barra final. Alimenta canonicals, OG e emails.
PUBLIC_URL=http://localhost:3000

# Pasta da base de dados. A base é um ficheiro SQLite lá dentro,
# `contagiarte.db`. Em produção isto é o volume montado na máquina.
DADOS_DIR=var

# Segredo das sessões do backoffice. Gerar com:
#   openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------
# Cloudflare R2 (imagens e PDFs)
# ---------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=contagiarte
# Domínio próprio do bucket, ex. https://media.contagiarte.pt
# Sem isto os ficheiros são servidos por /api/media (mais lento).
NEXT_PUBLIC_R2_PUBLIC_URL=

# ---------------------------------------------------------------
# Email (avisos de pedidos e confirmação de newsletter)
# Basta um dos dois. Sem nenhum, os pedidos ficam só na base de dados.
# ---------------------------------------------------------------
RESEND_API_KEY=
SMTP_URL=
EMAIL_DE="Galeria Contagiarte <site@contagiarte.pt>"
EMAIL_PARA=galeria@contagiarte.pt

# ---------------------------------------------------------------
# Entrar no backoffice com o Google. Vazio: email e palavra-passe,
# que é o que se quer localmente e nos testes.
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
# Emails, separados por vírgulas, que ficam administradores à primeira
# entrada com o Google.
ADMINISTRADORES=

# ---------------------------------------------------------------
# Opcional: protege o site inteiro com uma password. Vazio, o site
# está aberto.
# ---------------------------------------------------------------
STAGING_PASSWORD=

# Analítica sem cookies (opcional)
PLAUSIBLE_DOMAIN=
