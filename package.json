{
  "name": "contagiarte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "tipos": "tsc --noEmit",
    "bd:gerar": "drizzle-kit generate",
    "bd:migrar": "node --env-file=.env.local scripts/migrar.mjs",
    "bd:empurrar": "drizzle-kit push",
    "bd:estudio": "drizzle-kit studio",
    "semear": "tsx --env-file=.env.local scripts/semear.ts",
    "copia": "tsx --env-file=.env.local scripts/copia-seguranca.ts",
    "admin:criar": "tsx --env-file=.env.local scripts/criar-utilizador.ts",
    "bd:semear-ci": "tsx scripts/semear.ts",
    "e2e": "playwright test",
    "e2e:preparar": "tsx --env-file=.env.local scripts/preparar-e2e.ts",
    "e2e:ver": "playwright test --ui",
    "e2e:relatorio": "playwright show-report",
    "prestart": "mkdir -p .next/standalone/public .next/standalone/.next && cp -R public/. .next/standalone/public/ && cp -R .next/static/. .next/standalone/.next/static/",
    "imagens": "tsx --env-file=.env.local scripts/importar-imagens.ts",
    "galeria": "tsx --env-file=.env.local scripts/importar-galeria.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
